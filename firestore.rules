rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function emailLower() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : null;
    }

    function isOwner() {
      return emailLower() != null
        && exists(/databases/$(database)/documents/owners/$(emailLower()));
    }

    function isAdmin() {
      return isOwner() || (
        emailLower() != null
        && exists(/databases/$(database)/documents/admins/$(emailLower()))
      );
    }

    function isAllowed() {
      return isAdmin() || (
        emailLower() != null
        && exists(/databases/$(database)/documents/allowedEmails/$(emailLower()))
      );
    }

    function validYmd(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validSlot(s) {
      return s is string && s.matches('^[0-9]{2}:00$');
    }

    function validEmail(s) {
      return s is string && s.matches('^.+@.+[.].+$');
    }

    function bookingIdFor(date, slot, uid) {
      return date + '_' + slot + '_' + uid;
    }

    function scheduleDayPath(date) {
      return /databases/$(database)/documents/schedule/$(date);
    }

    function bookingPath(date, slot, uid) {
      return /databases/$(database)/documents/bookings/$(bookingIdFor(date, slot, uid));
    }

    function isStoredBookingPayload(d, ymd, slotId) {
      return d.keys().hasOnly(['date', 'slot', 'userId', 'name', 'email', 'createdAt'])
        && validYmd(d.date)
        && validSlot(d.slot)
        && d.date == ymd
        && d.slot == slotId
        && d.userId is string
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 80
        && d.email is string
        && validEmail(d.email)
        && d.createdAt is int;
    }

    function isBookingPayload(d, ymd, slotId) {
      return isStoredBookingPayload(d, ymd, slotId)
        && d.userId == request.auth.uid
        && d.email.lower() == emailLower();
    }

    function isStoredReservationPayload(d, ymd, slotId) {
      return d.keys().hasOnly([
          'date', 'slot', 'userId', 'name', 'email', 'createdAt',
          'reservedByRole', 'reservedByUid', 'reason'
        ])
        && validYmd(d.date)
        && validSlot(d.slot)
        && d.date == ymd
        && d.slot == slotId
        && d.userId is string
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 80
        && d.email is string
        && validEmail(d.email)
        && d.createdAt is int
        && d.reservedByUid is string
        && d.reservedByRole in ['owner', 'admin']
        && d.reason is string
        && d.reason.size() >= 1
        && d.reason.size() <= 120;
    }

    function isReservationPayload(d, ymd, slotId) {
      return isStoredReservationPayload(d, ymd, slotId)
        && d.userId == request.auth.uid
        && d.email.lower() == emailLower()
        && d.reservedByUid == request.auth.uid
        && (
          (d.reservedByRole == 'owner' && isOwner())
          || (d.reservedByRole == 'admin' && !isOwner() && isAdmin())
        );
    }

    function validScheduleDayShape(d) {
      return d.keys().hasOnly(['slots'])
        && d.slots is map
        && d.slots.keys().hasOnly([
          '08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00',
          '15:00', '16:00', '17:00', '18:00', '19:00', '20:00'
        ]);
    }

    function beforeScheduleSlots() {
      return resource == null || !(resource.data.slots is map)
        ? {}
        : resource.data.slots;
    }

    function addedSlotCount() {
      return request.resource.data.slots.diff(beforeScheduleSlots()).addedKeys().size();
    }

    function removedSlotCount() {
      return request.resource.data.slots.diff(beforeScheduleSlots()).removedKeys().size();
    }

    function onlySlotAffected(slotId) {
      return request.resource.data.slots.diff(beforeScheduleSlots()).affectedKeys().hasOnly([slotId]);
    }

    function slotAdded(slotId) {
      return !(slotId in beforeScheduleSlots()) && slotId in request.resource.data.slots;
    }

    function slotRemoved(slotId) {
      return (slotId in beforeScheduleSlots()) && !(slotId in request.resource.data.slots);
    }

    function changedSlotCount() {
      return request.resource.data.slots.diff(beforeScheduleSlots()).changedKeys().size();
    }

    function scheduleSlotAfter(date, slot) {
      return getAfter(scheduleDayPath(date)).data.slots[slot];
    }

    function isBookingAdditionForSlot(ymd, slotId) {
      return onlySlotAffected(slotId)
        && slotAdded(slotId)
        && isBookingPayload(request.resource.data.slots[slotId], ymd, slotId)
        && existsAfter(bookingPath(ymd, slotId, request.auth.uid));
    }

    function isSingleBookingAddition(ymd) {
      return isBookingAdditionForSlot(ymd, '08:00')
        || isBookingAdditionForSlot(ymd, '09:00')
        || isBookingAdditionForSlot(ymd, '10:00')
        || isBookingAdditionForSlot(ymd, '11:00')
        || isBookingAdditionForSlot(ymd, '12:00')
        || isBookingAdditionForSlot(ymd, '13:00')
        || isBookingAdditionForSlot(ymd, '14:00')
        || isBookingAdditionForSlot(ymd, '15:00')
        || isBookingAdditionForSlot(ymd, '16:00')
        || isBookingAdditionForSlot(ymd, '17:00')
        || isBookingAdditionForSlot(ymd, '18:00')
        || isBookingAdditionForSlot(ymd, '19:00')
        || isBookingAdditionForSlot(ymd, '20:00');
    }

    function isAdminSingleSlotWrite() {
      return isAdmin()
        && request.resource.data.slots.diff(beforeScheduleSlots()).affectedKeys().size() == 1;
    }

    function isAllowedSingleSlotRemoval() {
      return !isAdmin()
        && addedSlotCount() == 0
        && removedSlotCount() == 1
        && changedSlotCount() == 0;
    }

    // --- bookingGuards validation helpers ---
    function validGuardEntry(e, uid) {
      return e is map
        && e.keys().hasOnly(['id', 'date', 'slot', 'endMs'])
        && e.id is string
        && e.date is string
        && e.slot is string
        && e.endMs is number
        && validYmd(e.date)
        && validSlot(e.slot)
        && e.id == bookingIdFor(e.date, e.slot, uid)
        && e.endMs > 0;
    }

    // Validate entire active list (max 2 entries, checked per-index
    // because the CEL `list.all()` macro is not supported in Firestore rules).
    function validGuardActiveList(active, uid) {
      return active is list
        && (active.size() == 0
            || (active.size() == 1 && validGuardEntry(active[0], uid))
            || (active.size() == 2 && validGuardEntry(active[0], uid) && validGuardEntry(active[1], uid)));
    }

    // Allowlist (document id = lowercased email)
    match /allowedEmails/{emailId} {
      // Needed for pre-auth signup gating.
      // Note: this still allows enumeration by guessing emails.
      allow get: if true;
      allow list: if false;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'createdBy'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == emailId
        && validEmail(request.resource.data.email)
        && request.resource.data.createdAt is int
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.lower() == emailLower();

      allow delete: if isAdmin();
    }

    // Access requests (document id = lowercased email)
    match /accessRequests/{emailId} {
      // Users can create/refresh their own request before auth.
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is int
        && request.resource.data.email is string
        && request.resource.data.email.lower() == emailId
        && validEmail(request.resource.data.email)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80;

      // Allow resubmits/edits only while still pending.
      allow update: if resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == emailId
        && validEmail(request.resource.data.email)
        && request.resource.data.createdAt is int
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80;

      // Admin decisions (LOCKED DOWN KEYS)
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'status', 'createdAt', 'decidedAt', 'decidedBy'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == emailId
        && request.resource.data.status in ['pending', 'approved', 'denied']
        && request.resource.data.createdAt is int
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && (
          // If moving out of pending, require decision metadata.
          request.resource.data.status == 'pending'
          || (
            request.resource.data.decidedAt is int
            && request.resource.data.decidedBy is string
            && request.resource.data.decidedBy.lower() == emailLower()
          )
        );

      allow get: if isAdmin() || (signedIn() && emailLower() != null && emailId == emailLower());
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Role docs (document id = lowercased email)
    match /owners/{emailId} {
      allow get: if isOwner() || (signedIn() && emailLower() != null && emailId == emailLower());
      allow list: if isOwner();

      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'createdBy'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == emailId
        && validEmail(request.resource.data.email)
        && request.resource.data.createdAt is int
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.lower() == emailLower();

      allow delete: if isOwner();
    }

    match /admins/{emailId} {
      allow get: if isOwner() || (signedIn() && emailLower() != null && emailId == emailLower());
      allow list: if isOwner();

      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'createdBy'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == emailId
        && validEmail(request.resource.data.email)
        && request.resource.data.createdAt is int
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.lower() == emailLower();

      allow delete: if isOwner();
    }

    // Schedule days
    match /schedule/{date} {
      allow read: if isAllowed();
      allow delete: if false;

      allow create: if isAllowed()
        && validYmd(date)
        && validScheduleDayShape(request.resource.data)
        && (
          isSingleBookingAddition(date)
          || isAdminSingleSlotWrite()
        );

      allow update: if isAllowed()
        && !isAdmin()
        && validYmd(date)
        && validScheduleDayShape(request.resource.data)
        && addedSlotCount() == 1
        && removedSlotCount() == 0
        && changedSlotCount() == 0
        && isSingleBookingAddition(date);

      allow update: if isAllowed()
        && validYmd(date)
        && validScheduleDayShape(request.resource.data)
        && (
          isAdminSingleSlotWrite()
          || isAllowedSingleSlotRemoval()
        );
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if false;

      // Note: atomicity is enforced from the schedule-day side:
      // creating a schedule slot requires the matching booking doc in the same batch/transaction.
      allow create: if isAllowed()
        && isBookingPayload(request.resource.data, request.resource.data.date, request.resource.data.slot)
        && bookingId == bookingIdFor(request.resource.data.date, request.resource.data.slot, request.auth.uid)
        && existsAfter(scheduleDayPath(request.resource.data.date))
        && scheduleSlotAfter(request.resource.data.date, request.resource.data.slot).date == request.resource.data.date
        && scheduleSlotAfter(request.resource.data.date, request.resource.data.slot).slot == request.resource.data.slot
        && scheduleSlotAfter(request.resource.data.date, request.resource.data.slot).userId == request.auth.uid
        && scheduleSlotAfter(request.resource.data.date, request.resource.data.slot).name == request.resource.data.name
        && scheduleSlotAfter(request.resource.data.date, request.resource.data.slot).email == request.resource.data.email
        && scheduleSlotAfter(request.resource.data.date, request.resource.data.slot).createdAt == request.resource.data.createdAt;

      allow delete: if signedIn() && (
        resource != null && (resource.data.userId == request.auth.uid || isAdmin())
      );
    }

    // Per-user booking guards for active-cap enforcement.
    match /bookingGuards/{uid} {
      allow read: if signedIn() && (
        uid == request.auth.uid || isAdmin()
      );

      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['active', 'updatedAt'])
        && request.resource.data.updatedAt is int
        && request.resource.data.active is list
        && request.resource.data.active.size() <= 2
        && validGuardActiveList(request.resource.data.active, uid);

      // Keep your current behavior; consider denying user delete if you want to prevent "cap reset".
      allow delete: if signedIn() && (
        uid == request.auth.uid || isAdmin()
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
